generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5 + Prisma Adapter) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  username      String?   @unique
  bio           String?
  githubUsername String?  @map("github_username")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  plan          Plan?
  profileViews  ProfileView[]
  telegramBots  TelegramBot[]
  telegramChats TelegramChat[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Core Models ───

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  repoUrl     String?       @map("repo_url")
  deployUrl   String?       @map("deploy_url")
  stack       String[]      @default([])
  category    ProjectCategory @default(PERSONAL)
  shareToken  String?       @unique @map("share_token")
  userId      String        @map("user_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         Note[]
  tasks         Task[]
  milestones    Milestone[]
  timeLogs      TimeLog[]
  projectClicks ProjectClick[]

  @@unique([userId, slug])
  @@map("projects")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  type      NoteType @default(GENERAL)
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  order       Int          @default(0)
  projectId   String       @map("project_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  completed   Boolean   @default(false)
  dueDate     DateTime? @map("due_date")
  order       Int       @default(0)
  projectId   String    @map("project_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model TimeLog {
  id          String   @id @default(cuid())
  description String
  duration    Int      // duration in minutes
  cost        Decimal? @db.Decimal(10, 2)
  date        DateTime @default(now())
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

model Plan {
  id                   String     @id @default(cuid())
  userId               String     @unique @map("user_id")
  type                 PlanType   @default(FREE)
  status               PlanStatus @default(ACTIVE)
  stripeCustomerId     String?    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?    @unique @map("stripe_subscription_id")
  stripePriceId        String?    @map("stripe_price_id")
  billingCycle         BillingCycle? @map("billing_cycle")
  currentPeriodEnd     DateTime?  @map("current_period_end")
  cancelAtPeriodEnd    Boolean    @default(false) @map("cancel_at_period_end")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plans")
}

model ProfileView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  timestamp DateTime @default(now())
  referrer  String?
  country   String?
  path      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("profile_views")
}

model ProjectClick {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  timestamp DateTime @default(now())
  referrer  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, timestamp])
  @@map("project_clicks")
}

// ─── Telegram Bot Models ───

model TelegramBot {
  id            String    @id @default(cuid())
  name          String
  botUsername   String    @unique @map("bot_username")
  token         String    // Encrypted at rest via middleware
  webhookSecret String    @map("webhook_secret")
  handlerType   String    @map("handler_type")
  isEnabled     Boolean   @default(true) @map("is_enabled")
  config        Json?
  lastPingAt    DateTime? @map("last_ping_at")
  errorCount    Int       @default(0) @map("error_count")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs TelegramBotLog[]

  @@map("telegram_bots")
}

model TelegramBotLog {
  id        String   @id @default(cuid())
  botId     String   @map("bot_id")
  event     String   // "message", "command", "error", "webhook_set"
  payload   Json?
  level     String   @default("info") // "info", "warn", "error"
  createdAt DateTime @default(now()) @map("created_at")

  bot TelegramBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt])
  @@map("telegram_bot_logs")
}

model TelegramChat {
  id     String @id @default(cuid())
  chatId String @unique @map("chat_id")
  botId  String @map("bot_id")
  userId String @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_chats")
}

// ─── Enums ───

enum ProjectStatus {
  ACTIVE
  DEPLOYED
  STALE
  ARCHIVED
  PAUSED
}

enum ProjectCategory {
  PERSONAL
  CLIENT
  OPEN_SOURCE
  EXPERIMENT
}

enum NoteType {
  GENERAL
  ADR
  PROMPT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum PlanType {
  FREE
  PRO
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}
